DB_URL=jdbc:h2:mem:careconnect;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
DB_DRIVER_CLASS_NAME=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=change-me

# Render PostgreSQL example:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=<render_database_user>
# SPRING_DATASOURCE_PASSWORD=<render_database_password>

# If PostgreSQL is in a different Render account/workspace than the backend,
# use the database's external host/URL. The internal host only works from the
# same Render workspace/private network.

# Supabase Storage for private medical documents.
# Do not commit real values. SERVICE_ROLE_KEY must only exist server-side.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-side-service-role-key>
SUPABASE_STORAGE_BUCKET=documents
